
# Standard Python image (unlike Lambda image, this runs normal Linux processes)
FROM python:3.11-slim

# GDAL is required by rasterio to read JP2 satellite files
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first so Docker caches the pip install layer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and data
COPY src/      /app/src/
COPY data/     /app/data/
COPY scripts/  /app/scripts/

# Create output folders
RUN mkdir -p /app/models

# Make src/ importable (same as sys.path.insert in build_dataset.py)
ENV PYTHONPATH=/app/src

# Run the training pipeline when the container starts
ENTRYPOINT ["python", "/app/scripts/batch_train.py"]





